# Buraya kendi PostgreSQL bağlantı adresini yaz.
# Yerel kurulum örneği:
# DATABASE_URL=postgresql://postgres:SIFREN@localhost:5432/cepfiyat
#
# Neon (bulut) örneği:
# DATABASE_URL=postgresql://kullanici:sifre@ep-xxxx.eu-central-1.aws.neon.tech/cepfiyat?sslmode=require

DATABASE_URL=postgresql://postgres:SIFREN@localhost:5432/cepfiyat

# Yerel PostgreSQL için false, Neon/bulut için true bırak
DB_SSL=false

PORT=3000

# ---------------------------------------------------------------------
# Canlıya alırken ZORUNLU — bunlar yanlışsa CORS, sitemap ve ürün
# sayfası adresleri hep localhost'u gösterir.
# ---------------------------------------------------------------------

# Backend'in kendi genel adresi (ürün sayfaları, sitemap.xml bunu
# kullanır). Yerelde varsayılan localhost:PORT'tur.
BACKEND_URL=http://localhost:3000

# Frontend'in adresi — CORS SADECE bu origin'e izin verir, başka hiçbir
# yerden gelen isteği kabul etmez. Yerelde varsayılan localhost:5500'dür.
FRONTEND_URL=http://localhost:5500

# "production" yazarsan: http->https yönlendirmesi ve HSTS başlığı
# devreye girer. Yerel geliştirmede boş bırak.
NODE_ENV=

# ---------------------------------------------------------------------
# Opsiyonel — boş bırakılırsa ilgili özellik "ücretsiz/stub" modda
# sorunsuz çalışmaya devam eder.
# ---------------------------------------------------------------------

# "En güçlü model" araması ARTIK ÜCRETSİZ çalışıyor (çip+RAM tablosuyla,
# bkz. chip-tiers.js) — bu anahtara gerek yok, boş bırakabilirsin.
# Sadece daha nüanslı bir AI değerlendirmesi istersen (çok küçük bir
# ücret karşılığında) console.anthropic.com'dan alıp buraya ekleyebilirsin.
ANTHROPIC_API_KEY=

# GET /api/stats'ı herkese açık bırakmak istemiyorsan bir değer yaz;
# o zaman sadece ?key=BUDEGER ile eşleşen istekler görebilir. Boşsa
# endpoint korumasız kalır (yerel geliştirme için sorun değil).
STATS_KEY=

# POST /api/ingest-offer (scraper'ların fiyat/link BESLEDİĞİ uç nokta)
# için paylaşımlı anahtar. CANLIYA ALIRKEN MUTLAKA BİR DEĞER YAZ — boş
# bırakılırsa bu uç nokta kimliksiz kalır ve teorik olarak herhangi biri
# var olan bir satıcı adına (ör. "Hepsiburada") sahte fiyat/link
# ekleyebilir (rate limit dışında hiçbir engel kalmaz). Değer yazarsan,
# scraper'ın isteklerine "X-Ingest-Key: <bu değer>" başlığını eklemesi
# gerekir. Rastgele üretmek için: openssl rand -hex 32
INGEST_API_KEY=
